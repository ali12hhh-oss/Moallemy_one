#!/usr/bin/env sh

# Gradle startup script for POSIX shells.
# The wrapper JAR is intentionally kept in the repository; this script does not
# download build tooling from arbitrary locations.

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -f "$CLASSPATH" ]; then
  echo "ERROR: Gradle wrapper JAR is missing: $CLASSPATH" >&2
  echo "Run 'gradle wrapper --gradle-version 8.14' locally and commit the generated wrapper JAR." >&2
  exit 1
fi

if [ -n "${JAVA_HOME:-}" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

if ! command -v "$JAVACMD" >/dev/null 2>&1; then
  echo "ERROR: Java was not found. Set JAVA_HOME or put java on PATH." >&2
  exit 1
fi

exec "$JAVACMD" ${JAVA_OPTS:-} ${GRADLE_OPTS:-} -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
